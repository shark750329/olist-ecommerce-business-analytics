-- min, max and percentile_count by average time taken to complete the review --
WITH review_time AS (select DISTINCT review_id, review_creation_date, review_answer_timestamp,
 extract(day from review_creation_date) AS review_creation_days,extract(day from review_answer_timestamp) AS review_answer_day,
extract(hour from review_answer_timestamp) AS reviews_answer_hour
from order_reviews ),
review_timetaken AS (
select DISTINCT review_id, review_creation_date, review_answer_timestamp,
round(((review_answer_day - review_creation_days)*24 + reviews_answer_hour)/24,2) AS time_taken
from review_time)
SELECT
MIN(time_taken),MAX(time_taken),
PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY time_taken)
FROM review_timetaken
where NOT time_taken < 0


when  review_score between 3.0 AND 3.999 then 'between_3and4'
when review_score between 2.0 AND 2.999  then 'between_2and3'
when review_score between 1.0 AND 1.999  then 'between_1and2'
when review_score < 1  then 'below_than1'
END AS segment_review_ratings

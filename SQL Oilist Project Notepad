CREATE OR REPLACE VIEW review_analysis_base AS
WITH item_metrics AS (
    SELECT
        order_id,
        COUNT(*) AS item_count,
        COUNT(DISTINCT product_id) AS distinct_products,
        SUM(price) AS product_revenue,
        SUM(freight_value) AS freight_value,
        AVG(price) AS avg_item_price
    FROM order_items
    GROUP BY order_id
),

payment_metrics AS (
    SELECT
        order_id,
        SUM(payment_value) AS total_payment_value,
        MAX(payment_installments) AS max_installments
    FROM order_payments
    GROUP BY order_id
)

SELECT
    rc.review_id,
    rc.order_id,
    rc.review_score,
    rc.text_category,
    rc.score_sentiment,

    o.order_status,
    o.order_purchase_timestamp,
    o.order_approved_at,
    o.order_delivered_carrier_date,
    o.order_delivered_customer_date,
    o.order_estimated_delivery_date,

    c.customer_state,

    im.item_count,
    im.distinct_products,
    im.product_revenue,
    im.freight_value,
    im.avg_item_price,

    pm.total_payment_value,
    pm.max_installments,

    EXTRACT(EPOCH FROM (
        o.order_approved_at - o.order_purchase_timestamp
    )) / 3600.0 AS approval_hours,

    EXTRACT(EPOCH FROM (
        o.order_delivered_carrier_date - o.order_approved_at
    )) / 3600.0 AS approval_to_carrier_hours,

    EXTRACT(EPOCH FROM (
        o.order_delivered_customer_date
        - o.order_delivered_carrier_date
    )) / 86400.0 AS carrier_to_customer_days,

    EXTRACT(EPOCH FROM (
        o.order_delivered_customer_date
        - o.order_purchase_timestamp
    )) / 86400.0 AS total_delivery_days,

    EXTRACT(EPOCH FROM (
        o.order_delivered_customer_date
        - o.order_estimated_delivery_date
    )) / 86400.0 AS delay_days

FROM vw_order_review_labeled rc
JOIN orders o
    ON rc.order_id = o.order_id
LEFT JOIN customers c
    ON o.customer_id = c.customer_id
LEFT JOIN item_metrics im
    ON o.order_id = im.order_id
LEFT JOIN payment_metrics pm
    ON o.order_id = pm.order_id;


-- which text tags are associated with the lowest ratings --
WITH baseline AS (
    SELECT AVG(review_score::numeric) AS overall_avg_score
    FROM review_analysis_base
    WHERE review_score BETWEEN 1 AND 5
)

SELECT
    b.text_category,
    COUNT(*) AS review_count,

    ROUND(AVG(b.review_score::numeric), 3)
        AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE b.review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE b.review_score = 5
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS five_star_pct,

    ROUND(
        AVG(b.review_score::numeric) - MAX(bl.overall_avg_score),
        3
    ) AS difference_from_baseline
FROM review_analysis_base b
CROSS JOIN baseline bl
WHERE b.text_category <> 'no_text'
GROUP BY b.text_category
HAVING COUNT(*) >= 30
ORDER BY avg_review_score ASC;

-- does delivery delays correlate with review scores ?--
SELECT
    COUNT(*) AS delivered_reviews,
 ROUND(
        corr(
            review_score::double precision,
            delay_days::double precision
        )::numeric,
        4
    ) AS correlation_delay_vs_score,

    ROUND(AVG(review_score::numeric), 3)
        AS overall_avg_score,

    ROUND(AVG(delay_days::numeric), 2)
        AS avg_delay_days

FROM review_analysis_base
WHERE order_status = 'delivered'
  AND review_score BETWEEN 1 AND 5
  AND delay_days IS NOT NULL;

-- review scores of the late delivery orders --
SELECT
    CASE
        WHEN delay_days <= 0 THEN 'On time or early'
        WHEN delay_days <= 3 THEN '1-3 days late'
        WHEN delay_days <= 7 THEN '4-7 days late'
        ELSE 'More than 7 days late'
        END AS delay_category,

    COUNT(*) AS reviews,
    ROUND(AVG(review_score::numeric), 3) AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE text_category = 'late_delivery'
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS late_delivery_tag_pct

FROM review_analysis_base
WHERE order_status = 'delivered'
  AND delay_days IS NOT NULL
  AND review_score BETWEEN 1 AND 5
GROUP BY 1


-- product category is associated with low ratings ? --
WITH order_category AS (
    SELECT DISTINCT
        oi.order_id,
        COALESCE(
            pct.product_category_name_english,
            p.product_category_name
        ) AS category
    FROM order_items oi
    JOIN products p
        ON oi.product_id = p.product_id
    LEFT JOIN product_category_name pct
        ON p.product_category_name =
           pct.product_category_name
)
SELECT
    oc.category,
    COUNT(*) AS reviews,

    ROUND(AVG(b.review_score::numeric), 3)
        AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE b.review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE b.text_category IN (
                'defect_or_damage',
                'poor_quality',
                'wrong_or_fake_product',
                'missing_item'
            )
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS product_issue_tag_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE b.text_category IN (
                'late_delivery',
                'non_delivery'
            )
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS delivery_issue_tag_pct

FROM review_analysis_base b
JOIN order_category oc
    ON b.order_id = oc.order_id
WHERE b.review_score BETWEEN 1 AND 5
  AND oc.category IS NOT NULL
GROUP BY oc.category
HAVING COUNT(*) >= 100
ORDER BY low_rating_pct DESC;

-- Testing freight burden against review scores--
WITH freight_analysis AS (
    SELECT
        review_id,
        order_id,
        review_score,
        freight_value,
        product_revenue,

        freight_value / NULLIF(product_revenue, 0)
            AS freight_to_revenue_ratio

    FROM review_analysis_base
    WHERE review_score BETWEEN 1 AND 5
      AND freight_value IS NOT NULL
      AND product_revenue > 0
)SELECT
    COUNT(*) AS reviews,
ROUND(
        corr(
            review_score::double precision,
            freight_to_revenue_ratio::double precision
        )::numeric,
        4
    ) AS freight_ratio_vs_rating_corr,
ROUND(AVG(review_score::numeric), 3)
        AS avg_review_score,
ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct
FROM freight_analysis;


-- Testing freight burden against review scores--
WITH freight_analysis AS (
    SELECT
        review_score,
        freight_value / NULLIF(product_revenue, 0)
            AS freight_ratio
    FROM review_analysis_base
    WHERE review_score BETWEEN 1 AND 5
      AND product_revenue > 0
      AND freight_value IS NOT NULL
)SELECT
    CASE
        WHEN freight_ratio < 0.05 THEN 'Under 5%'
        WHEN freight_ratio < 0.10 THEN '5-10%'
        WHEN freight_ratio < 0.20 THEN '10-20%'
        WHEN freight_ratio < 0.30 THEN '20-30%'
        ELSE '30% or more'
    END AS freight_ratio_group,

    COUNT(*) AS reviews,
    ROUND(AVG(review_score::numeric), 3)
        AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct

FROM freight_analysis
GROUP BY 1

-- Testing payment approval delay against review scores --
SELECT
    CASE
        WHEN approval_hours IS NULL THEN 'Missing approval time'
        WHEN approval_hours < 5 THEN 'Under 5 hours'
        WHEN approval_hours < 10 THEN '5-10 hours'
        WHEN approval_hours < 25 THEN '10-25 hours'
        WHEN approval_hours < 50 THEN '25-50 hours'
        ELSE '50+ hours'
    END AS approval_delay_group,

    COUNT(*) AS reviews,
    ROUND(AVG(review_score::numeric), 3)
        AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct

FROM review_analysis_base
WHERE review_score BETWEEN 1 AND 5
GROUP BY 1


-- comparing tags against operational metrics --
SELECT
    text_category,
    COUNT(*) AS reviews,
ROUND(AVG(review_score::numeric), 3)
        AS avg_review_score,
ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS low_rating_pct,
ROUND(
        (AVG(delay_days::numeric)
            FILTER (WHERE order_status = 'delivered')),
        2
    ) AS avg_delivery_delay_days,
ROUND(
        (AVG(total_delivery_days::numeric)
            FILTER (WHERE order_status = 'delivered')),
        2
    ) AS avg_total_delivery_days,
ROUND(
        AVG(
            (freight_value / NULLIF(product_revenue, 0))::numeric
        ),
        3
    ) AS avg_freight_ratio,
ROUND(AVG(approval_hours::numeric), 2)
        AS avg_approval_hours
FROM review_analysis_base
WHERE review_score BETWEEN 1 AND 5
  AND text_category <> 'no_text'
GROUP BY text_category
HAVING COUNT(*) >= 30
ORDER BY avg_review_score ASC;


-- low ratings are concentrated in particular customer destinations ? --
SELECT
    customer_state,
    COUNT(*) AS reviews,

    ROUND(AVG(review_score::numeric), 3)
        AS avg_review_score,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE review_score <= 2
        ) / NULLIF(COUNT(*), 0),

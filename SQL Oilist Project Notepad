CREATE OR REPLACE VIEW vw_order_review_labeled AS
WITH normalized AS (
    SELECT
        r.review_id,
        r.order_id,
        r.review_score,
        r.review_comment_title,
        r.review_comment_message,
        r.review_creation_date,
        r.review_answer_timestamp,
        LOWER(
            COALESCE(r.review_comment_title,   '') || ' ' ||
            COALESCE(r.review_comment_message, '')
        ) AS txt_lower,
        (NULLIF(BTRIM(r.review_comment_title),   '') IS NOT NULL) AS has_title,
        (NULLIF(BTRIM(r.review_comment_message), '') IS NOT NULL) AS has_message,
        LENGTH(NULLIF(BTRIM(r.review_comment_message), ''))        AS message_length,
        /* Compact normalized string used only for exact-match short reviews */
        TRIM(LOWER(
            COALESCE(r.review_comment_title,   '') || ' ' ||
            COALESCE(r.review_comment_message, '')
        )) AS txt_exact
    FROM order_reviews r
)
SELECT
    review_id,
    order_id,
    review_score,
    review_comment_title,
    review_comment_message,
    review_creation_date,
    review_answer_timestamp,
    has_title,
    has_message,
    message_length,
    txt_lower,
    txt_exact,

    CASE
        WHEN review_score <= 2 THEN 'negative'
        WHEN review_score  = 3 THEN 'neutral_or_mixed'
        ELSE                        'positive'
    END AS score_sentiment,

    CASE
        /* 0. Empty review - cannot be labeled by keywords */
        WHEN NOT has_title AND NOT has_message
            THEN 'no_text'

        /* 1. Non-delivery */
        WHEN txt_lower LIKE '%não recebi%' OR txt_lower LIKE '%nao recebi%'
          OR txt_lower LIKE '%ainda não recebi%' OR txt_lower LIKE '%ainda nao recebi%'
          OR txt_lower LIKE '%não chegou%' OR txt_lower LIKE '%nao chegou%'
          OR txt_lower LIKE '%nunca chegou%' OR txt_lower LIKE '%nunca recebi%'
          OR txt_lower LIKE '%não foi entregue%' OR txt_lower LIKE '%nao foi entregue%'
          OR txt_lower LIKE '%não recebemos%' OR txt_lower LIKE '%nao recebemos%'
          OR txt_lower LIKE '%extraviado%' OR txt_lower LIKE '%extravio%'
          OR txt_lower LIKE '%consta como entregue%'
            THEN 'non_delivery'

        /* 2. Negative recommendation - BEFORE positive "recomendo" */
        WHEN txt_lower LIKE '%não recomendo%' OR txt_lower LIKE '%nao recomendo%'
          OR txt_lower LIKE '%não recomendaria%' OR txt_lower LIKE '%nao recomendaria%'
          OR txt_lower LIKE '%nunca mais compro%'
          OR txt_lower LIKE '%não compro mais%' OR txt_lower LIKE '%nao compro mais%'
          OR txt_lower LIKE '%não compraria%' OR txt_lower LIKE '%nao compraria%'
            THEN 'negative_recommendation'

        /* 3. Wrong / fake product */
        WHEN txt_lower LIKE '%produto errado%' OR txt_lower LIKE '%produto diferente%'
          OR txt_lower LIKE '%veio outro%' OR txt_lower LIKE '%veio errado%'
          OR txt_lower LIKE '%veio diferente%'
          OR txt_lower LIKE '%não corresponde%' OR txt_lower LIKE '%nao corresponde%'
          OR txt_lower LIKE '%modelo errado%' OR txt_lower LIKE '%cor errada%'
          OR txt_lower LIKE '%cor diferente%' OR txt_lower LIKE '%tamanho errado%'
          OR txt_lower LIKE '%tamanho diferente%'
          OR txt_lower LIKE '%falso%' OR txt_lower LIKE '%falsificado%'
          OR txt_lower LIKE '%réplica%' OR txt_lower LIKE '%replica%'
          OR txt_lower LIKE '%pirata%'
            THEN 'wrong_or_fake_product'

        /* 4. Defect / damage */
        WHEN txt_lower LIKE '%defeito%' OR txt_lower LIKE '%quebrado%'
          OR txt_lower LIKE '%quebrada%' OR txt_lower LIKE '%danificado%'
          OR txt_lower LIKE '%danificada%' OR txt_lower LIKE '%amassado%'
          OR txt_lower LIKE '%amassada%'
          OR txt_lower LIKE '%não funciona%' OR txt_lower LIKE '%nao funciona%'
          OR txt_lower LIKE '%vazando%' OR txt_lower LIKE '%riscado%'
          OR txt_lower LIKE '%trincado%'
            THEN 'defect_or_damage'

        /* 5. Missing item */
        WHEN txt_lower LIKE '%faltou%' OR txt_lower LIKE '%faltando%'
          OR txt_lower LIKE '%faltam%' OR txt_lower LIKE '%incompleto%'
          OR txt_lower LIKE '%só veio um%' OR txt_lower LIKE '%so veio um%'
          OR txt_lower LIKE '%recebi apenas%' OR txt_lower LIKE '%recebi somente%'
          OR txt_lower LIKE '%somente um%' OR txt_lower LIKE '%veio faltando%'
          OR txt_lower LIKE '%faltaram%'
            THEN 'missing_item'

        /* 6. Late delivery */
        WHEN txt_lower LIKE '%atraso%' OR txt_lower LIKE '%atrasou%'
          OR txt_lower LIKE '%atrasado%' OR txt_lower LIKE '%atrasada%'
          OR txt_lower LIKE '%demora%' OR txt_lower LIKE '%demorou%'
          OR txt_lower LIKE '%fora do prazo%' OR txt_lower LIKE '%passou do prazo%'
          OR txt_lower LIKE '%prazo não cumprido%' OR txt_lower LIKE '%prazo nao cumprido%'
            THEN 'late_delivery'

        /* 7. Fast / on-time delivery */
        WHEN txt_lower LIKE '%antes do prazo%' OR txt_lower LIKE '%no prazo%'
          OR txt_lower LIKE '%entrega rápida%' OR txt_lower LIKE '%entrega rapida%'
          OR txt_lower LIKE '%chegou rápido%' OR txt_lower LIKE '%chegou rapido%'
          OR txt_lower LIKE '%chegou antes%' OR txt_lower LIKE '%entregue antes%'
          OR txt_lower LIKE '%antecedência%' OR txt_lower LIKE '%antecedencia%'
            THEN 'fast_delivery'

        /* 8. Generic negative - BEFORE positive */
        WHEN txt_lower LIKE '%não gostei%' OR txt_lower LIKE '%nao gostei%'
          OR txt_lower LIKE '%detestei%'
          OR txt_lower LIKE '%péssimo%' OR txt_lower LIKE '%pessimo%'
          OR txt_lower LIKE '%horrível%' OR txt_lower LIKE '%horrivel%'
          OR txt_lower LIKE '%ruim%' OR txt_lower LIKE '%arrependi%'
          OR txt_lower LIKE '%decepcionad%' OR txt_lower LIKE '%insatisfeit%'
            THEN 'negative_generic'

        /* 9. Quality-specific */
        WHEN txt_lower LIKE '%qualidade%'
         AND (txt_lower LIKE '%ruim%' OR txt_lower LIKE '%baixa%'
           OR txt_lower LIKE '%péssima%' OR txt_lower LIKE '%pessima%'
           OR txt_lower LIKE '%fraca%')
            THEN 'poor_quality'
        WHEN txt_lower LIKE '%qualidade%'
         AND (txt_lower LIKE '%boa%' OR txt_lower LIKE '%ótima%'
           OR txt_lower LIKE '%otima%' OR txt_lower LIKE '%excelente%')
            THEN 'good_quality'

        /* 10. Return / refund / cancel intent */
        WHEN txt_lower LIKE '%devolução%' OR txt_lower LIKE '%devolucao%'
          OR txt_lower LIKE '%devolver%' OR txt_lower LIKE '%estorno%'
          OR txt_lower LIKE '%reembolso%' OR txt_lower LIKE '%cancelamento%'
          OR txt_lower LIKE '%cancelar%'
            THEN 'return_refund_cancel'

        /* 11. Customer service */
        WHEN txt_lower LIKE '%atendimento%'
          OR txt_lower LIKE '%sac %' OR txt_lower LIKE '%sac,%' OR txt_lower LIKE '%sac.%'
          OR txt_lower LIKE '%suporte%'
          OR txt_lower LIKE '%não respondem%' OR txt_lower LIKE '%nao respondem%'
          OR txt_lower LIKE '%ninguém responde%' OR txt_lower LIKE '%ninguem responde%'
          OR txt_lower LIKE '%sem resposta%' OR txt_lower LIKE '%sem retorno%'
            THEN 'customer_service'

        /* 12. Freight / price */
        WHEN txt_lower LIKE '%frete caro%' OR txt_lower LIKE '%frete alto%'
          OR txt_lower LIKE '%frete muito caro%' OR txt_lower LIKE '%frete abusivo%'
          OR txt_lower LIKE '%frete elevado%'
            THEN 'expensive_freight'
        WHEN txt_lower LIKE '%preço bom%' OR txt_lower LIKE '%preco bom%'
          OR txt_lower LIKE '%bom preço%' OR txt_lower LIKE '%bom preco%'
          OR txt_lower LIKE '%custo benefício%' OR txt_lower LIKE '%custo beneficio%'
            THEN 'good_price'

        /* 13. Packaging */
        WHEN txt_lower LIKE '%embalagem%'
         AND (txt_lower LIKE '%amassada%' OR txt_lower LIKE '%rasgada%'
           OR txt_lower LIKE '%violada%' OR txt_lower LIKE '%danificada%'
           OR txt_lower LIKE '%mal embalad%')
            THEN 'bad_packaging'
        WHEN txt_lower LIKE '%bem embalad%' OR txt_lower LIKE '%bem acondicionad%'
            THEN 'good_packaging'

        /* 14. Positive recommendation - AFTER negative */
        WHEN txt_lower LIKE '%recomendo%' OR txt_lower LIKE '%indico%'
          OR txt_lower LIKE '%super recomendo%'
          OR txt_lower LIKE '%nota 10%' OR txt_lower LIKE '%nota dez%'
            THEN 'positive_recommendation'

        /* 15. Exact-match short generics (cheap, catches "Bom", "Ok", "Top", etc.) */
        WHEN txt_exact IN (
            'bom','boa','muito bom','muito boa','ok','ótimo','otimo','otima','ótima',
            'excelente','perfeito','perfeita','maravilhoso','maravilhosa','lindo','linda',
            'top','show','legal','bacana','valeu','blz','beleza','sim','sim!','amei',
            'gostei','gostei muito','muito bom mesmo','10','nota 10','nota dez',
            'satisfeito','satisfeita','tudo certo','tudo ok','tudo bom','recomendo',
            'super recomendo','recomendo!','muito boa mesmo'
        ) THEN 'positive_generic'

        WHEN txt_exact IN (
            'ruim','péssimo','pessimo','horrível','horrivel','não gostei','nao gostei',
            'detestei','1','2','3','não recomendo','nao recomendo','não','nao',
            'nenhuma','n','nao!','não!'
        ) THEN 'negative_generic'

        /* 16. Broad positive fallback (after all negatives) */
        WHEN txt_lower LIKE '%muito bom%' OR txt_lower LIKE '%muito boa%'
          OR txt_lower LIKE '%bom produto%' OR txt_lower LIKE '%boa qualidade%'
          OR txt_lower LIKE '%ótimo%' OR txt_lower LIKE '%otimo%'
          OR txt_lower LIKE '%excelente%' OR txt_lower LIKE '%maravilhos%'
          OR txt_lower LIKE '%perfeito%' OR txt_lower LIKE '%perfeita%'
          OR txt_lower LIKE '%amei%' OR txt_lower LIKE '%gostei%'
          OR txt_lower LIKE '%lindo%' OR txt_lower LIKE '%linda%'
            THEN 'positive_generic'

        ELSE 'other'
    END AS text_category,

    (txt_lower LIKE '%lannister%')  AS mentions_lannister,
    (txt_lower LIKE '%targaryen%')  AS mentions_targaryen,
    (txt_lower LIKE '%stark%')      AS mentions_stark,
    (txt_lower LIKE '%baratheon%')  AS mentions_baratheon,
    (txt_lower LIKE '%correios%')   AS mentions_correios
FROM normalized;


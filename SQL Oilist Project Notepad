-- RFM ANALYSIS  --
Create VIEW x AS 
WITH order_revenue AS (
    SELECT
        order_id,
        SUM(price) AS order_revenue
    FROM order_items
    GROUP BY order_id
),

completed_orders AS (
    SELECT
        o.order_id,
        c.customer_unique_id,
        o.order_purchase_timestamp::date AS order_date,
        COALESCE(r.order_revenue, 0) AS order_revenue
    FROM orders o
    JOIN customers c
        ON o.customer_id = c.customer_id
    LEFT JOIN order_revenue r
        ON o.order_id = r.order_id
    WHERE o.order_status = 'delivered'
      AND o.order_purchase_timestamp IS NOT NULL
),

reference_date AS (
    SELECT MAX(order_date) + 1 AS ref_date
    FROM completed_orders
),

customer_rfm AS (
    SELECT
        co.customer_unique_id,
        MAX(co.order_date) AS last_purchase_date,

        (rd.ref_date - MAX(co.order_date))
            AS recency_days,

        COUNT(DISTINCT co.order_id)
            AS frequency,

        SUM(co.order_revenue)
            AS monetary

    FROM completed_orders co
    CROSS JOIN reference_date rd
    GROUP BY
        co.customer_unique_id,
        rd.ref_date
),

percentiles AS (
    SELECT
        *,
        PERCENT_RANK() OVER (
            ORDER BY recency_days DESC
        ) AS r_pct,

        PERCENT_RANK() OVER (
            ORDER BY frequency ASC
        ) AS f_pct,

        PERCENT_RANK() OVER (
            ORDER BY monetary ASC
        ) AS m_pct

    FROM customer_rfm
),

rfm_scores AS (
    SELECT
        customer_unique_id,
        last_purchase_date,
        recency_days,
        frequency,
        ROUND(monetary::numeric, 2) AS monetary,

        CASE
            WHEN r_pct < 0.2 THEN 1
            WHEN r_pct < 0.4 THEN 2
            WHEN r_pct < 0.6 THEN 3
            WHEN r_pct < 0.8 THEN 4
            ELSE 5
        END AS R_score,

        CASE
            WHEN f_pct < 0.2 THEN 1
            WHEN f_pct < 0.4 THEN 2
            WHEN f_pct < 0.6 THEN 3
            WHEN f_pct < 0.8 THEN 4
            ELSE 5
        END AS F_score,

        CASE
            WHEN m_pct < 0.2 THEN 1
            WHEN m_pct < 0.4 THEN 2
            WHEN m_pct < 0.6 THEN 3
            WHEN m_pct < 0.8 THEN 4
            ELSE 5
        END AS M_score

    FROM percentiles
)

SELECT *
FROM rfm_scores
ORDER BY R_score DESC, F_score DESC, M_score DESC;


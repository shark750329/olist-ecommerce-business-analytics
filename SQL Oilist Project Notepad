    ) AS low_rating_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE text_category IN (
                'late_delivery',
                'non_delivery'
            )
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS delivery_issue_tag_pct,

    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE text_category IN (
                'defect_or_damage',
                'poor_quality',
                'wrong_or_fake_product',
                'missing_item'
            )
        ) / NULLIF(COUNT(*), 0),
        2
    ) AS product_issue_tag_pct
FROM review_analysis_base
WHERE review_score BETWEEN 1 AND 5
  AND customer_state IS NOT NULL
GROUP BY customer_state
HAVING COUNT(*) >= 100
ORDER BY low_rating_pct DESC;



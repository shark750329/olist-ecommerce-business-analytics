select 
TO_CHAR(count(distinct order_id), '999,999,999')
from order_items

select 
TO_CHAR(
    (count(distinct order_id) * 100.0 )/ sum(count(Distinct o.order_id)) 
    Over(), '999.00'
    ) || '%' AS order_count ,
product_category_name
from order_items AS o
Left Join products AS p on p.product_id = o.product_id
where p.product_category_name is not null
Group by product_category_name
order by order_count desc
Limit 10;

select product_category_name,
to_char(AVG(price), '999.00') AS average_price
from order_items AS o
Left Join products AS p on p.product_id = o.product_id
where p.product_category_name is not null
Group by product_category_name
order by average_price desc;

select product_category_name,
to_char(sum(freight_value), '999.00') AS total_price
from order_items AS o
Left Join products AS p on p.product_id = o.product_id
where p.product_category_name is not null
Group by product_category_name
order by total_price desc;


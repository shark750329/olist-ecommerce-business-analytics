Create View Order_items_payment AS
SELECT 
    O.order_id,
    O.price,
    O.freight_value,
    OP.payment_type,
    OP.payment_value,
    OP.payment_installments
FROM order_items AS O
LEFT JOIN order_payments AS OP
    ON O.order_id = OP.order_id;

select *
from order_items_payment

select 
payment_type,
TO_CHAR(sum(payment_value),'999,999,999') AS Total_Payments
from order_items_payment
group by payment_type

select 
payment_type,
Avg(payment_installments) AS Average_installments
from order_items_payment
where payment_installments IS NOT NUll
group by payment_type

